    "cn": "^0.4.0",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
