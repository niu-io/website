---
import { getCollection, render } from "astro:content";
import { publishedPosts } from "../../content/blog-policy";
import { IconArrowRight, IconPin } from "@tabler/icons-react";
import BlogLayout from "../../layouts/BlogLayout.astro";

const posts = publishedPosts(await getCollection("blog"));
const entries = await Promise.all(
  posts.map(async (post) => {
    const { headings } = await render(post);
    return { post, sections: headings.filter((heading) => heading.depth === 2) };
  }),
);

function formatDate(isoDate: string): string {
  const [year, month, day] = isoDate.split("-").map(Number);
  return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}

function getReadingTime(body: string | undefined, explicit?: string): string {
  if (explicit) return explicit;
  const words = (body ?? "").trim().split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.round(words / 220));
  return `${minutes} min read`;
}
---

<BlogLayout
  title="Blog"
  description="Product and engineering notes on operating a model API business: delivery, accounting and customer trust."
>
  <header class="blog-intro">
    <p class="blog-eyebrow" data-en="Blog" data-zh="博客">Blog</p>
    <h1 data-en="Building a model API business" data-zh="构建并运营模型 API 商业服务">Building a model API business</h1>
    <p
      data-en="Product and engineering decisions behind model delivery, clear accounts, and a service customers can trust."
      data-zh="围绕模型路由交付、清晰的财务账本与可信赖客户服务背后的产品与工程实践。"
    >
      Product and engineering decisions behind model delivery, clear accounts,
      and a service customers can trust.
    </p>
  </header>

  <section class="blog-list" aria-label="Published articles">
    {entries.map(({ post, sections }) => {
      const href = `/blog/${post.id}/`;
      const readingTime = getReadingTime(post.body, post.data.readingTime);
      return (
        <article class="blog-entry">
          <div class="blog-entry-body">
            <div class="blog-entry-meta">
              {post.data.pinned && (
                <span class="blog-pinned">
                  <IconPin size={13} aria-hidden="true" />
                  <span data-en="Pinned" data-zh="置顶">Pinned</span>
                </span>
              )}
              <span class="blog-entry-category">{post.data.category}</span>
              <time datetime={post.data.publishedAt}>{formatDate(post.data.publishedAt)}</time>
              <span>{readingTime}</span>
            </div>
            <h2>
              <a href={href}>{post.data.title}</a>
            </h2>
            {post.data.chineseTitle && (
              <p class="blog-entry-zh" lang="zh-CN">
                {post.data.chineseTitle}
              </p>
            )}
            <p class="blog-entry-summary">{post.data.description}</p>
            <div class="blog-entry-footer">
              <span class="blog-byline">
                <span class="blog-byline-avatar" aria-hidden="true">
                  <img src="/site-assets/brand/niu-mark.png" alt="" width="20" height="20" />
                </span>
                <span class="blog-byline-author">{post.data.author}</span>
              </span>
              <a class="blog-read-link" href={href} aria-label={`Read article: ${post.data.title}`}>
                <span data-en="Read article" data-zh="阅读全文">Read article</span>
                <IconArrowRight size={15} aria-hidden="true" />
              </a>
            </div>
          </div>
          {sections.length > 1 && (
            <nav class="blog-entry-outline" aria-label={`${post.data.title} sections`}>
              <p data-en="In this article" data-zh="本文内容">In this article</p>
              <ol>
                {sections.map((section, index) => (
                  <li>
                    <span class="blog-entry-outline-index">{String(index + 1).padStart(2, "0")}</span>
                    <a href={`${href}#${section.slug}`}>{section.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
        </article>
      );
    })}
  </section>
  <script is:inline>
    (()=>{const sync=()=>{const zh=document.documentElement.dataset.locale==='zh-CN'||document.documentElement.lang==='zh-CN';document.querySelectorAll('main [data-en][data-zh]').forEach(el=>{el.textContent=el.getAttribute(zh?'data-zh':'data-en')||'';});};sync();window.addEventListener('niu-locale-change',sync);window.addEventListener('storage',sync);})();
  </script>
</BlogLayout>
