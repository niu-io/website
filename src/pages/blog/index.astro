---
import { getCollection } from "astro:content";
import { publishedPosts } from "../../content/blog-policy";
import { formatDate, readingTime } from "../../content/blog-format";
import { IconArrowRight } from "@tabler/icons-react";
import BlogLayout from "../../layouts/BlogLayout.astro";
const posts = publishedPosts(await getCollection("blog"));
const translations = publishedPosts(await getCollection("blogTranslations"));
---

<BlogLayout
  title="Blog"
  chineseTitle="博客"
  description="Ideas and engineering behind better model access, reliable requests and clear token spending."
  chineseDescription="关于模型接入、可靠请求与清晰词元开支的产品思考和工程实践。"
>
  <header class="blog-intro">
    <p class="blog-eyebrow" data-en="The Niu blog" data-zh="牛元博客">
      The Niu blog
    </p>
    <h1 data-en="Make every token count." data-zh="让每个词元发挥更大价值">
      Make every token count.
    </h1>
    <p
      data-en="Ideas, decisions and engineering behind better model access."
      data-zh="关于模型接入的产品思考、架构选择与工程实践。"
    >
      Ideas, decisions and engineering behind better model access.
    </p>
  </header>
  <section class="blog-list" aria-label="Blog">
    {posts.map((post) => {
      const zh = translations.find((item) => item.id === post.id);
      const href = `/blog/${post.id}/`;
      return (
        <article class="blog-entry">
          <a
            class={`blog-cover ${post.id === "compare" ? "blog-cover-compare" : ""}`}
            href={href}
            tabindex="-1"
            aria-hidden="true"
          >
            {post.data.cover && (
              <img
                src={post.data.cover}
                alt=""
                width="1672"
                height="941"
                loading="eager"
              />
            )}
          </a>
          <div class="blog-entry-body">
            <div class="blog-entry-meta">
              <span
                class="blog-entry-category"
                data-en={post.data.category}
                data-zh={zh?.data.category ?? post.data.category}
              >
                {post.data.category}
              </span>
              <time
                datetime={post.data.publishedAt}
                data-en={formatDate(post.data.publishedAt)}
                data-zh={formatDate(post.data.publishedAt, "zh-CN")}
              >
                {formatDate(post.data.publishedAt)}
              </time>
              <span
                data-en={readingTime(post.body)}
                data-zh={readingTime(zh?.body ?? post.body, "zh-CN")}
              >
                {readingTime(post.body)}
              </span>
            </div>
            <h2>
              <a
                href={href}
                data-en={post.data.title}
                data-zh={zh?.data.title ?? post.data.title}
              >
                {post.data.title}
              </a>
            </h2>
            <p
              class="blog-entry-summary"
              data-en={post.data.description}
              data-zh={zh?.data.description ?? post.data.description}
            >
              {post.data.description}
            </p>
            <div class="blog-entry-footer">
              <span class="blog-byline">
                <span
                  class="blog-byline-author"
                  data-en={post.data.author}
                  data-zh={zh?.data.author ?? post.data.author}
                >
                  {post.data.author}
                </span>
              </span>
              <a class="blog-read-link" href={href}>
                <span data-en="Read article" data-zh="阅读全文">
                  Read article
                </span>
                <IconArrowRight size={16} aria-hidden="true" />
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </section>
  <script>
    const sync = () => {
      const key =
        document.documentElement.dataset.locale === "zh-CN"
          ? "data-zh"
          : "data-en";
      document
        .querySelectorAll<HTMLElement>("main [data-en][data-zh]")
        .forEach((el) => {
          el.textContent = el.getAttribute(key) ?? "";
        });
    };
    sync();
    window.addEventListener("niu-locale-change", sync);
    window.addEventListener("storage", sync);
  </script>
</BlogLayout>
