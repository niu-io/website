---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { Button } from "../../components/ui/button";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(isoDate: string): string {
  const [year, month, day] = isoDate.split("-").map(Number);
  return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}

function getReadingTime(body: string | undefined, explicit?: string): string {
  if (explicit) return explicit;
  const words = (body ?? "").trim().split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.round(words / 220));
  return `${minutes} min read`;
}

const readingTime = getReadingTime(post.body, post.data.readingTime);
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <article>
    <header class="blog-article-header">
      <a class="blog-back" href="/blog/">
        ← All articles
      </a>
      <div class="blog-article-meta">
        <span class="blog-entry-category">{post.data.category}</span>
        <span>·</span>
        <time datetime={post.data.publishedAt}>
          {formatDate(post.data.publishedAt)}
        </time>
        <span>·</span>
        <span>{readingTime}</span>
        <span>·</span>
        <span>{post.data.author}</span>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.chineseTitle && (
        <p class="blog-article-zh" lang="zh-CN">
          {post.data.chineseTitle}
        </p>
      )}
      <p class="blog-article-lead">{post.data.description}</p>
    </header>

    <div class="blog-prose">
      <Content />
    </div>

    <footer class="blog-article-footer">
      <div>
        <h2>Explore the open-source core</h2>
        <p>
          Inspect the Rust gateway, three-ledger accounting schema, and the
          <code>niu.plugin.v1</code> SDK.
        </p>
      </div>
      <div class="blog-article-actions">
        <Button asChild>
          <a href="/docs/guides/api-quickstart/">Get started</a>
        </Button>
        <Button asChild variant="outline">
          <a href="https://github.com/niu-io/niu">View on GitHub</a>
        </Button>
      </div>
    </footer>
  </article>
</BlogLayout>
