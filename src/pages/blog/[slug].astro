---
import { getCollection } from "astro:content";
import { publishedPosts } from "../../content/blog-policy";
import BlogLayout from "../../layouts/BlogLayout.astro";
import BlogArticle from "../../components/BlogArticle.astro";
import BlogArticleFooter from "../../components/BlogArticleFooter";
export async function getStaticPaths() {
  const translations = await getCollection("blogTranslations");
  return publishedPosts(await getCollection("blog")).map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      translation: publishedPosts(translations).find(
        (item) => item.id === post.id,
      ),
    },
  }));
}
const { post, translation } = Astro.props;
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  chineseTitle={translation?.data.title}
  chineseDescription={translation?.data.description}
  ogType="article"
  image={post.data.cover}
>
  <BlogArticle post={post} locale="en" cover={post.data.cover} />
  {translation && (
    <BlogArticle post={translation} locale="zh-CN" cover={post.data.cover} />
  )}
  <div class="blog-article">
    <BlogArticleFooter client:load />
  </div>
  <script>
    const sync = () => {
      const zh = document.documentElement.dataset.locale === "zh-CN";
      document
        .querySelectorAll<HTMLElement>("main [data-en][data-zh]")
        .forEach((el) => {
          el.textContent = el.getAttribute(zh ? "data-zh" : "data-en") ?? "";
        });
      const articles = [
        ...document.querySelectorAll<HTMLElement>("[data-blog-language]"),
      ];
      const chosen =
        articles.find((article) => article.lang === (zh ? "zh-CN" : "en")) ??
        articles[0];
      // Keep a linked section meaningful when switching the article language.
      let hash = "";
      try {
        hash = decodeURIComponent(location.hash.slice(1));
      } catch {
        /* Invalid external hash. */
      }
      const previous = articles.find(
        (article) =>
          article.querySelectorAll(".blog-prose h2").length &&
          [...article.querySelectorAll(".blog-prose h2")].some(
            (heading) => heading.id === hash,
          ),
      );
      const index = previous
        ? [...previous.querySelectorAll(".blog-prose h2")].findIndex(
            (heading) => heading.id === hash,
          )
        : -1;
      articles.forEach((article) => {
        article.hidden = article !== chosen;
      });
      if (index >= 0 && previous !== chosen) {
        const target =
          chosen?.querySelectorAll<HTMLElement>(".blog-prose h2")[index];
        if (target) {
          history.replaceState(
            history.state,
            "",
            `${location.pathname}${location.search}#${encodeURIComponent(target.id)}`,
          );
          target.scrollIntoView();
        }
      }
    };
    sync();
    window.addEventListener("niu-locale-change", sync);
    window.addEventListener("storage", sync);
    document
      .querySelectorAll<HTMLElement>("[data-copy-link]")
      .forEach((copy) => {
        copy.addEventListener("click", async () => {
          const label = copy.querySelector<HTMLElement>("[data-copy-label]");
          const zh = document.documentElement.dataset.locale === "zh-CN";
          try {
            await navigator.clipboard.writeText(location.href);
            if (label) label.textContent = zh ? "已复制" : "Copied";
          } catch {
            if (label) label.textContent = zh ? "复制失败" : "Copy failed";
          }
          setTimeout(sync, 1800);
        });
      });
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries)
            if (entry.isIntersecting) {
              const article = entry.target.closest("[data-blog-language]");
              article
                ?.querySelectorAll<HTMLElement>("[data-toc-link]")
                .forEach((link) => {
                  if (link.dataset.tocLink === entry.target.id)
                    link.setAttribute("aria-current", "location");
                  else link.removeAttribute("aria-current");
                });
            }
        },
        { rootMargin: "-96px 0px -65% 0px" },
      );
      document
        .querySelectorAll(".blog-prose h2")
        .forEach((heading) => observer.observe(heading));
    }
  </script>
</BlogLayout>
