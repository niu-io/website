---
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/compare-ui.css";
import "../styles/public-header.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getCollection } from "astro:content";
import { publishedPosts } from "../content/blog-policy";
import "../styles/landing-blog.css";
import "../styles/landing-visual.css";
import LandingContent from "../components/LandingContent";
import { codeExamples } from "../content/landing";
import { codeToHtml } from "shiki";
const highlightedCode = await Promise.all(
  codeExamples.map((example) =>
    codeToHtml(example.code, {
      lang: example.language,
      themes: { light: "github-light", dark: "github-dark" },
    }),
  ),
);

const latestPosts = publishedPosts(await getCollection("blog"))
  .slice(0, 3)
  .map(({ id, data, body }) => ({
    href: `/blog/${id}/`,
    title: data.title,
    chineseTitle: data.chineseTitle,
    description: data.description,
    category: data.category,
    publishedAt: data.publishedAt,
    dateLabel: new Date(`${data.publishedAt}T00:00:00Z`).toLocaleDateString(
      "en-US",
      {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
      },
    ),
    readingTime:
      data.readingTime ??
      `${Math.max(1, Math.round((body ?? "").trim().split(/\s+/).filter(Boolean).length / 220))} min read`,
    highlights: Array.from((body ?? "").matchAll(/^##\s+(.+)$/gm), (m) =>
      m[1].trim(),
    ).slice(0, 4),
  }));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (path: string) => `${base}/${path}`;
const title = "Niu — Make every token count";
const description =
  "A token management platform for developers and teams. Access model APIs with performance, reliability and clear control over token usage and spending.";
const canonical = new URL(`${base}/`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fa" />
    <link rel="icon" href={asset("favicon.ico")} sizes="any" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={
        new URL(asset("site-assets/brand/niu-social-en-dark.png"), Astro.site)
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const html = document.documentElement;
        const syncScroll = () =>
          html.classList.toggle("is-scrolled", window.scrollY > 8);
        syncScroll();
        window.addEventListener("scroll", syncScroll, { passive: true });
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        html.classList.add("motion-ready");
        setTimeout(() => {
          if (!window.__niuMotion) html.classList.remove("motion-ready");
        }, 3000);
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <LandingContent
      client:load
      latestPosts={latestPosts}
      highlightedCode={highlightedCode}
    />
    <SiteFooter />
  </body>
</html>
