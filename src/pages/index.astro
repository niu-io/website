---
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/compare-ui.css";
import "../styles/public-header.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/landing-visual.css";
import "../styles/landing-sections.css";
import LandingContent from "../components/LandingContent";
import { protocolExamples } from "../content/landing";
import { codeToHtml } from "shiki";
const highlightedProtocols = await Promise.all(
  protocolExamples.map((example) =>
    codeToHtml(example.code, {
      lang: example.language,
      themes: { light: "github-light", dark: "github-dark" },
    }),
  ),
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (path: string) => `${base}/${path}`;
const title = "Niu — The Model Platform for Agents";
const description =
  "Discover and evaluate models, configure routing, and manage performance and cost—all through your agent.";
const canonical = new URL(`${base}/`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#EEEDEA"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#141312"
    />
    <link rel="icon" href={asset("favicon.ico")} sizes="any" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={
        new URL(asset("site-assets/brand/niu-social-en-dark.png"), Astro.site)
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const html = document.documentElement;
        const syncScroll = () =>
          html.classList.toggle("is-scrolled", window.scrollY > 8);
        syncScroll();
        window.addEventListener("scroll", syncScroll, { passive: true });
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        html.classList.add("motion-ready");
        setTimeout(() => {
          if (!window.__niuMotion) html.classList.remove("motion-ready");
        }, 3000);
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <LandingContent client:load highlightedProtocols={highlightedProtocols} />
    <SiteFooter />
  </body>
</html>
