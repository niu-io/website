---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/compare-ui.css';
import '../styles/public-header.css';
import SiteHeader from '../components/SiteHeader.astro';
import { getCollection } from 'astro:content';
import { publishedPosts } from '../content/blog-policy';
import '../styles/landing-blog.css';
import '../styles/landing-visual.css';
import LandingContent from '../components/LandingContent';
import { links, codeExamples } from '../content/landing';
import { codeToHtml } from 'shiki';
const highlightedCode = await Promise.all(codeExamples.map(example => codeToHtml(example.code, {
  lang: example.language,
  themes: { light: 'github-light', dark: 'github-dark' },
})));

const latestPosts = publishedPosts(await getCollection('blog'))
  .slice(0, 3)
  .map(({ id, data, body }) => ({
    href: `/blog/${id}/`,
    title: data.title,
    description: data.description,
    category: data.category,
    publishedAt: data.publishedAt,
    dateLabel: new Date(`${data.publishedAt}T00:00:00Z`).toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
    }),
    readingTime: data.readingTime ?? `${Math.max(1, Math.round((body ?? '').trim().split(/\s+/).filter(Boolean).length / 220))} min read`,
    highlights: Array.from((body ?? '').matchAll(/^##\s+(.+)$/gm), (m) => m[1].trim()).slice(0, 4),
  }));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path}`;
const title = 'Niu — Build your model API business';
const description = 'Open-source infrastructure for model aggregation businesses. Operate model supply, keep clear accounts, and give customers a service they can trust.';
const canonical = new URL(`${base}/`, Astro.site);
---
<!doctype html><html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fa" />
    <link rel="icon" href={asset("favicon.ico")} sizes="any" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={
        new URL(asset("site-assets/brand/niu-logo-dark.png"), Astro.site)
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const html = document.documentElement;
        const syncScroll = () => html.classList.toggle('is-scrolled', window.scrollY > 8);
        syncScroll();
        window.addEventListener('scroll', syncScroll, { passive: true });
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        html.classList.add('motion-ready');
        setTimeout(() => { if (!window.__niuMotion) html.classList.remove('motion-ready'); }, 3000);
      })();
    </script>
  </head>

<body>
<a class="skip-link" href="#main">Skip to content</a><SiteHeader />
<LandingContent client:load latestPosts={latestPosts} highlightedCode={highlightedCode} />
<footer class="container footer"><div><a class="wordmark" href="/" aria-label="Niu home"><img src={asset('site-assets/brand/niu-mark.png')} alt="" width="28" height="28"/><span>Niu</span></a><p>Open-source foundations for your model API business.</p></div><div class="footer-links"><a href="/models/">Models</a><a href="/workspaces/default/">Dashboard</a><a href="/docs/">Documentation</a><a href="/blog/why-niu/">Why Niu?</a><a href="/blog/">Blog</a><a href="/compare/">Compare</a><a href={links.repo}>GitHub</a><a href={`${links.repo}/blob/main/THIRD-PARTY-NOTICES.md`}>Licenses & attribution</a><a href="https://github.com/niu-io/website">Website source</a></div></footer>
</body></html>
