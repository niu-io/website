---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/compare-ui.css';
import '../styles/public-header.css';
import SiteHeader from '../components/SiteHeader.astro';
import LandingContent from '../components/LandingContent';
import { links } from '../content/landing';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path}`;
const title = 'Niu — Model access, clear usage and accountable spending';
const description = 'A model API gateway for applications: connect Suppliers, manage workspace budgets, inspect usage and billing, and work with text and video generation.';
const canonical = new URL(`${base}/`, Astro.site);
---
<!doctype html><html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fa" />
    <link rel="icon" href={asset("favicon.ico")} sizes="any" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={
        new URL(asset("site-assets/brand/niu-logo-dark.png"), Astro.site)
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>

<body>
<a class="skip-link" href="#main">Skip to content</a><SiteHeader />
<LandingContent />
<footer class="container footer"><div><a class="wordmark" href="/" aria-label="Niu home"><img src={asset('site-assets/brand/niu-mark.png')} alt="" width="28" height="28"/><span>Niu</span></a><p>Model access with transparent usage and billing.</p></div><div class="footer-links"><a href="/models/">Models</a><a href="/workspaces/default/">Console</a><a href="/docs/">Documentation</a><a href={links.repo}>GitHub</a><a href={`${links.repo}/blob/main/THIRD-PARTY-NOTICES.md`}>Licenses & attribution</a><a href="https://github.com/niu-io/website">Website source</a></div></footer>
</body></html>
