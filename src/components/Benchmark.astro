---
import { benchmarkSteps, benchmarkSuites } from "../content/benchmarks";
import { links } from "../content/landing";
---

<section
  class="benchmark-section container"
  id="benchmark"
  aria-labelledby="benchmark-title"
>
  <div class="benchmark-heading">
    <div>
      <p class="eyebrow">AI GATEWAY PERFORMANCE BENCHMARK</p>
      <h2 id="benchmark-title">
        Built in Rust for high throughput
        <br />
        and predictable tail latency.
      </h2>
    </div>
    <p>
      Evaluated with the open-source <code>ai-gateway-bench</code> harness against
      a deterministic 0ms mock upstream on Apple M4 with PostgreSQL 17.11—comparing
      Niu, New API, and LiteLLM Proxy across concurrency tiers, SSE streaming,
      and multi-turn coding agent sessions.
    </p>
  </div>
  <ol class="benchmark-steps">
    {benchmarkSteps.map((item) => (
      <li>
        <span>{item.step}</span>
        <div>
          <strong>{item.title}</strong>
          <p>{item.description}</p>
        </div>
      </li>
    ))}
  </ol>
  <div class="benchmark-demo">
    <div class="benchmark-toolbar">
      <span class="sample-label">
        REPRODUCIBLE AI-GATEWAY-BENCH SUITE · 0MS MOCK UPSTREAM ON LOOPBACK
      </span>
      <span class="benchmark-status">
        Apple M4 (10-core, 24 GB) · PostgreSQL 17.11 · October 2026
      </span>
    </div>
    <div
      class="benchmark-tabs"
      role="tablist"
      aria-label="Choose a benchmark workload"
    >
      {benchmarkSuites.map((suite, i) => (
        <button
          type="button"
          role="tab"
          id={`benchmark-tab-${suite.id}`}
          aria-controls={`benchmark-panel-${suite.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          {suite.label}
        </button>
      ))}
    </div>
    {benchmarkSuites.map((suite, i) => (
      <div
        class="benchmark-panel"
        role="tabpanel"
        id={`benchmark-panel-${suite.id}`}
        aria-labelledby={`benchmark-tab-${suite.id}`}
        hidden={i !== 0}
        tabindex="0"
      >
        <div class="benchmark-task">
          <div>
            <span class="small-label">{suite.eyebrow}</span>
            <h3>{suite.title}</h3>
            <p>{suite.description}</p>
          </div>
          <div class="acceptance-rule">
            <strong>{suite.ruleTitle}</strong>
            <span>{suite.ruleDetail}</span>
          </div>
        </div>
        <div class="model-comparison">
          {suite.cards.map((card) => (
            <article
              class:list={["model-result", { "model-winner": card.isWinner }]}
            >
              <div class="model-title">
                <div>
                  <h4>{card.name}</h4>
                  <p>{card.runtime}</p>
                </div>
                <span class="model-verdict">{card.badge}</span>
              </div>
              <div class="per-result">
                <span>{card.primaryUnit}</span>
                <strong>{card.primaryMetric}</strong>
                <small>{card.primarySubtext}</small>
              </div>
              <div class="fusion-cost-bar" aria-hidden="true">
                <i style={`width: ${card.barPercent}%`} />
              </div>
              <dl class="model-facts">
                {card.facts.map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
            </article>
          ))}
        </div>
        <div
          class="comparison-scroll"
          role="region"
          aria-label={suite.title}
          tabindex="0"
        >
          <table class="comparison-matrix benchmark-matrix">
            <caption class="sr-only">
              {suite.title} comparison across Niu, New API, and LiteLLM Proxy.
            </caption>
            <thead>
              <tr>
                <th scope="col">Metric</th>
                <th scope="col" class="matrix-selected">
                  <strong>Niu (v0.2.4)</strong>
                  <small>Rust · Axum · Tokio + PostgreSQL</small>
                </th>
                <th scope="col">
                  <strong>New API (45fbb14)</strong>
                  <small>Go · Gin · GORM + PostgreSQL</small>
                </th>
                <th scope="col">
                  <strong>LiteLLM Proxy (v1.104.0)</strong>
                  <small>Python · FastAPI · Uvicorn</small>
                </th>
              </tr>
            </thead>
            <tbody>
              {suite.rows.map((row) => (
                <tr class:list={{ "matrix-key": row.isKeyRow }}>
                  <th scope="row">{row.metric}</th>
                  <td class="matrix-selected">
                    <strong>{row.niu}</strong>
                    {row.niuSub && <small>{row.niuSub}</small>}
                  </td>
                  <td>
                    {row.isKeyRow ? <strong>{row.newApi}</strong> : row.newApi}
                    {row.newApiSub && <small>{row.newApiSub}</small>}
                  </td>
                  <td>
                    {row.isKeyRow ? <strong>{row.litellm}</strong> : row.litellm}
                    {row.litellmSub && <small>{row.litellmSub}</small>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="benchmark-verdict">
          <div class="verdict-number">
            <strong>{suite.verdictNumber}</strong>
            <span>{suite.verdictSub}</span>
          </div>
          <div>
            <h4>{suite.verdictTitle}</h4>
            <p>{suite.verdictBody}</p>
          </div>
        </div>
      </div>
    ))}
    <div class="benchmark-method">
      <p>
        <strong>Methodology:</strong> Adapted from{" "}
        <code>BerriAI/ai-gateway-bench</code>. All three gateways ran on the
        same Apple M4 host (10-core CPU, 24 GB RAM, macOS arm64) over loopback
        against a zero-delay Rust/Axum mock upstream (36,649 RPS direct
        baseline) with 32 warmup requests per run.
      </p>
      <p>
        Niu ran with full ACID PostgreSQL 17.11 pre-dispatch request admission
        and micro-batched completion settlement; New API ran with{" "}
        <code>MEMORY_CACHE_ENABLED=true</code> and{" "}
        <code>BATCH_UPDATE_ENABLED=true</code>; LiteLLM Proxy ran in its
        fastest stateless <code>master_key</code> mode with database spend logs
        disabled.
      </p>
    </div>
  </div>
  <div class="benchmark-next">
    <p>
      <strong>Inspect the methodology, full tables, and reproduction steps.</strong>{" "}
      Real production capacity depends on your hardware, PostgreSQL topology,
      and upstream Provider latency—qualify the routes you deploy.
    </p>
    <a class="text-link" href={links.benchmark}>
      Read the full benchmark documentation <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
