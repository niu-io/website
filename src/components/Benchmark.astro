---
import { benchmarkExamples, totalCents, dollars } from "../content/benchmarks";
import { links } from "../content/landing";
---

<section
  class="benchmark-section container"
  id="benchmark"
  aria-labelledby="benchmark-title"
>
  <div class="benchmark-heading">
    <div>
      <p class="eyebrow">ONE EXAMPLE: A CODING TASK</p>
      <h2 id="benchmark-title">
        Which model gets the code right
        <br />
        for less?
      </h2>
    </div>
    <p>
      Coding is one example of complex agent work. Run the same coding task with
      different models. Check the same tests. Compare the cost of an accepted
      result—not just the price of a token.
    </p>
  </div>
  <ol class="benchmark-steps">
    <li>
      <span>01</span>
      <div>
        <strong>Hold the task constant</strong>
        <p>Same repo snapshot, agent, prompt and tools.</p>
      </div>
    </li>
    <li>
      <span>02</span>
      <div>
        <strong>Check the result</strong>
        <p>Same tests, acceptance rules and time limit.</p>
      </div>
    </li>
    <li>
      <span>03</span>
      <div>
        <strong>Count the whole run</strong>
        <p>Include failed runs, repairs and validation.</p>
      </div>
    </li>
  </ol>
  <div class="benchmark-demo">
    <div class="benchmark-toolbar">
      <span class="sample-label">
        INTERACTIVE EXAMPLE · ALL NUMBERS ARE HYPOTHETICAL
      </span>
      <span class="benchmark-status">Benchmark workflow planned</span>
    </div>
    <div
      class="benchmark-tabs"
      role="tablist"
      aria-label="Choose a coding task"
    >
      {benchmarkExamples.map((example, i) => (
        <button
          type="button"
          role="tab"
          id={`benchmark-tab-${example.id}`}
          aria-controls={`benchmark-panel-${example.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          {example.label}
        </button>
      ))}
    </div>
    {benchmarkExamples.map((example, i) => {
      const eligible = example.models.filter(
        (model) => model.accepted === 10 && model.slowest <= 10,
      );
      const winner = eligible.reduce((best, model) =>
        totalCents(model) / model.accepted < totalCents(best) / best.accepted
          ? model
          : best,
      );
      const baseline = example.models[0];
      const saving = Math.round(
        (1 - totalCents(winner) / totalCents(baseline)) * 100,
      );
      const maxSpend = Math.max(...example.models.map(totalCents));
      return (
        <div
          class="benchmark-panel"
          role="tabpanel"
          id={`benchmark-panel-${example.id}`}
          aria-labelledby={`benchmark-tab-${example.id}`}
          hidden={i !== 0}
          tabindex="0"
        >
          <div class="benchmark-task">
            <div>
              <span class="small-label">
                SAME TASK · 10 INDEPENDENT RUNS PER MODEL
              </span>
              <h3>{example.task}</h3>
              <p>{example.checks}</p>
            </div>
            <div class="acceptance-rule">
              <strong>Acceptance bar</strong>
              <span>10 / 10 passes · each run ≤ 10 min</span>
            </div>
          </div>
          <div class="model-comparison">
            {example.models.map((model) => (
              <article
                class:list={[
                  "model-result",
                  { "model-winner": model === winner },
                ]}
              >
                <div class="model-title">
                  <div>
                    <h4>{model.name}</h4>
                    <p>{model.tier}</p>
                  </div>
                  <span
                    class:list={[
                      "model-verdict",
                      { "is-rejected": model.accepted < 10 },
                    ]}
                  >
                    {model === winner
                      ? "Best eligible"
                      : model.accepted < 10
                        ? "Below quality bar"
                        : "Meets quality bar"}
                  </span>
                </div>
                <div class="per-result">
                  <span>COST PER ACCEPTED RESULT</span>
                  <strong>
                    {model.accepted
                      ? dollars(totalCents(model) / model.accepted)
                      : "Undefined"}
                  </strong>
                  <small>
                    {dollars(totalCents(model))} total ÷ {model.accepted}{" "}
                    accepted
                  </small>
                </div>
                <dl class="model-facts">
                  <div>
                    <dt>Accepted runs</dt>
                    <dd>{model.accepted} / 10</dd>
                  </div>
                  <div>
                    <dt>Slowest run</dt>
                    <dd>{model.slowest} min</dd>
                  </div>
                  <div>
                    <dt>Total cohort spend</dt>
                    <dd>{dollars(totalCents(model))}</dd>
                  </div>
                </dl>
                <div class="spend-bar" aria-hidden="true">
                  <span
                    class="spend-initial"
                    style={`width:${(model.initial / maxSpend) * 100}%`}
                  ></span>
                  <span
                    class="spend-repair"
                    style={`width:${(model.repair / maxSpend) * 100}%`}
                  ></span>
                  <span
                    class="spend-checks"
                    style={`width:${(model.checks / maxSpend) * 100}%`}
                  ></span>
                </div>
                <dl class="spend-breakdown">
                  <div>
                    <dt>
                      <i class="spend-initial"></i>Initial work
                    </dt>
                    <dd>{dollars(model.initial)}</dd>
                  </div>
                  <div>
                    <dt>
                      <i class="spend-repair"></i>Repairs & retries
                    </dt>
                    <dd>{dollars(model.repair)}</dd>
                  </div>
                  <div>
                    <dt>
                      <i class="spend-checks"></i>Tools & validation
                    </dt>
                    <dd>{dollars(model.checks)}</dd>
                  </div>
                </dl>
              </article>
            ))}
          </div>
          <div class="benchmark-verdict">
            <div class="verdict-number">
              <strong>{saving ? `${saving}%` : "Keep A"}</strong>
              <span>
                {saving
                  ? "lower cost in this example"
                  : "no qualifying cheaper option"}
              </span>
            </div>
            <div>
              <h4>
                {saving
                  ? "Use Model B for this kind of task."
                  : "A cheaper token isn’t always a cheaper fix."}
              </h4>
              <p>{example.explanation}</p>
            </div>
          </div>
        </div>
      );
    })}
    <div class="benchmark-method">
      <p>
        <strong>The decision:</strong> total spend across all runs ÷ accepted
        results, subject to your quality and latency requirements.
      </p>
      <p>
        These invented cohorts explain the method, not expected savings or real
        model rankings. Modeled spend includes model calls, retries, tools and
        validation; human review is excluded. Ten illustrative runs do not
        establish reliability. Real comparisons need representative tasks,
        repeated trials, cost coverage and uncertainty.
      </p>
    </div>
  </div>
  <div class="benchmark-next">
    <p>
      <strong>Observe → benchmark → combine → validate.</strong> Task traces
      show where the work goes. Controlled comparisons test whether another
      model can do that work for less. The next step is to test a mix of models
      across the complete task, including switching and repair costs. Model
      fusion is planned; the examples above compare individual models.
    </p>
    <a class="text-link" href={links.release}>
      Follow the benchmark roadmap <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="fusion-story">
    <div>
      <p class="eyebrow">MODEL FUSION · PLANNED METHODOLOGY</p>
      <h3>
        The right model for each part.
        <br />
        One acceptance bar for the task.
      </h3>
      <p>
        A single model need not do everything. Test whether combining models can
        reduce total cost without losing task quality.
      </p>
    </div>
    <ol>
      <li>
        <strong>Understand the task</strong>
        <span>Inspect token usage, elapsed time and retries at each step.</span>
      </li>
      <li>
        <strong>Test a model mix</strong>
        <span>
          For example: a stronger model for planning, a lower-cost model for
          routine edits, and escalation where needed.
        </span>
      </li>
      <li>
        <strong>Validate the whole result</strong>
        <span>
          Run the same acceptance checks. Include handoffs, repeated context,
          failures and validation in total task cost.
        </span>
      </li>
    </ol>
  </div>
</section>
<script>
  const benchmarkTabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>(
      '.benchmark-tabs [role="tab"]',
    ),
  );
  const selectBenchmark = (tab: HTMLButtonElement) => {
    benchmarkTabs.forEach((item) => {
      const selected = item === tab;
      item.setAttribute("aria-selected", String(selected));
      item.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(
        item.getAttribute("aria-controls") || "",
      );
      if (panel) panel.hidden = !selected;
    });
  };
  benchmarkTabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectBenchmark(tab));
    tab.addEventListener("keydown", (event) => {
      let next = index;
      if (event.key === "ArrowRight") next = (index + 1) % benchmarkTabs.length;
      else if (event.key === "ArrowLeft")
        next = (index - 1 + benchmarkTabs.length) % benchmarkTabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = benchmarkTabs.length - 1;
      else return;
      event.preventDefault();
      selectBenchmark(benchmarkTabs[next]);
      benchmarkTabs[next].focus();
    });
  });
</script>
