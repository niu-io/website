---
import PublicHeader from './PublicHeader';
import '../styles/site-header.css';
---
<script is:inline>
(()=>{let value='system',loc='';try{value=localStorage.getItem('niu-dashboard-theme')||'system';loc=localStorage.getItem('niu-dashboard-locale')||'';}catch{}const dark=value==='dark'||(value==='system'&&matchMedia('(prefers-color-scheme: dark)').matches);const html=document.documentElement;html.classList.toggle('dark',dark);html.style.colorScheme=dark?'dark':'light';const zh=/^zh\b/i.test(loc||navigator.language||'');html.lang=zh?'zh-CN':'en';html.dataset.locale=zh?'zh-CN':'en';const syncScroll=()=>html.classList.toggle('is-scrolled',window.scrollY>8);syncScroll();window.addEventListener('scroll',syncScroll,{passive:true});})();
</script>
<PublicHeader path={Astro.url.pathname} client:load/>
