---
import NiuBrand from "./NiuBrand";
import { links } from "../content/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const footerGroups = [
  {
    title: "Product",
    titleZh: "产品",
    links: [
      { label: "Models", labelZh: "模型目录", href: "/models/" },
      { label: "Dashboard", labelZh: "控制台", href: links.dashboard },
      { label: "Generations", labelZh: "生成工作台", href: "/docs/reference/generations/" },
      { label: "Benchmarks", labelZh: "性能基准", href: links.benchmark },
    ],
  },
  {
    title: "Developers",
    titleZh: "开发者",
    links: [
      { label: "Getting started", labelZh: "快速开始", href: links.quickstart },
      { label: "Docs", labelZh: "文档", href: "/docs/" },
      { label: "REST API", labelZh: "REST API", href: links.api },
      { label: "JavaScript SDK", labelZh: "JavaScript SDK", href: "/docs/api/sdk/" },
      { label: "Self-hosting", labelZh: "私有化部署", href: links.deployment },
    ],
  },
  {
    title: "Resources",
    titleZh: "资源",
    links: [
      { label: "Why Niu?", labelZh: "为什么选择牛元？", href: "/blog/why-niu/" },
      { label: "Blog", labelZh: "博客", href: "/blog/" },
      { label: "Compare gateways", labelZh: "网关对比", href: links.compare },
      { label: "Niu vs. OpenRouter", labelZh: "Niu vs. OpenRouter", href: "/compare/openrouter/" },
      { label: "Niu vs. LiteLLM", labelZh: "Niu vs. LiteLLM", href: "/compare/litellm/" },
    ],
  },
  {
    title: "Open Source",
    titleZh: "开源",
    links: [
      { label: "GitHub", labelZh: "GitHub", href: links.repo },
      { label: "Website source", labelZh: "官网源码", href: "https://github.com/niu-io/website" },
      { label: "Release matrix", labelZh: "版本矩阵", href: links.release },
      {
        label: "Third-party notices",
        labelZh: "第三方声明",
        href: `${links.repo}/blob/main/THIRD-PARTY-NOTICES.md`,
      },
      {
        label: "Brand attribution",
        labelZh: "品牌署名",
        href: `${base}/site-assets/brand/SOURCE-LICENSE.txt`,
      },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container site-footer-inner">
    <div class="site-footer-grid">
      <div class="site-footer-meta">
        <a class="site-footer-brand" href="/" aria-label="Niu home">
          <NiuBrand />
        </a>
        <p class="site-footer-tagline" data-en="Token management for developers and teams." data-zh="面向开发者与团队的 词元管理平台。">
          Token management for developers and teams.
        </p>
        <p class="site-footer-submeta" data-en="MIT License · Self-hosted & cloud" data-zh="MIT 开源协议 · 支持私有化部署与云端托管">MIT License · Self-hosted &amp; cloud</p>
      </div>

      <nav class="site-footer-columns" aria-label="Footer navigation">
        {footerGroups.map((group) => (
          <div class="site-footer-group">
            <h3 data-en={group.title} data-zh={group.titleZh}>{group.title}</h3>
            <ul>
              {group.links.map((item) => (
                <li>
                  <a href={item.href} data-en={item.label} data-zh={item.labelZh}>{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
  </div>
</footer>
<script is:inline>
(()=>{const sync=()=>{const zh=document.documentElement.dataset.locale==='zh-CN'||document.documentElement.lang==='zh-CN';document.querySelectorAll('footer.site-footer [data-en][data-zh]').forEach(el=>{el.textContent=el.getAttribute(zh?'data-zh':'data-en')||'';});};sync();window.addEventListener('niu-locale-change',sync);window.addEventListener('storage',sync);})();
</script>
